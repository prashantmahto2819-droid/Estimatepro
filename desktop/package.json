{
  "name": "estimate-pro-desktop",
  "productName": "Estimate Pro",
  "version": "1.0.0",
  "description": "Estimate Pro for Windows",
  "author": "Estimate Pro",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --publish never" },
  "devDependencies": { "electron": "^33.0.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "in.estimatepro.desktop",
    "productName": "Estimate Pro",
    "files": ["main.js", "offline.html", "icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }], "icon": "icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Estimate Pro", "artifactName": "EstimatePro-Setup-${version}.exe" },
    "portable": { "artifactName": "EstimatePro-Portable-${version}.exe" }
  }
}
